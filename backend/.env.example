# Copy this file to .env and fill in real values before running.

PORT=4000
NODE_ENV=development

# PostgreSQL connection (must have the PostGIS extension available)
DATABASE_URL=postgres://suraksha:suraksha@localhost:5432/suraksha_ai

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS — the frontend's origin
CORS_ORIGIN=http://localhost:5173

# File storage — local disk by default. Set to "s3" or "supabase" and fill in the
# matching block below to use cloud storage instead. Local disk is fine for a
# hackathon demo; use cloud storage before any real deployment.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# --- Optional: S3-compatible storage ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Optional: Supabase storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=inspection-evidence
